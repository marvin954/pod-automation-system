{
  "name": "POD - Design Generation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-design",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "design-trigger",
      "name": "Design Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "pod-generate-design"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 500,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"You are an expert prompt engineer for AI image generation. Enhance this design prompt for print-on-demand products (t-shirts, mugs, posters). Add art style, composition, colors, and print-friendly details. Output only the enhanced prompt, nothing else.\\n\\nPrompt: {{ $json.prompt }}\"\n  }]\n}",
        "options": {}
      },
      "id": "enhance-prompt",
      "name": "Enhance Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://image.pollinations.ai/prompt/{{ encodeURIComponent($json.content[0].text) }}?width=1024&height=1024&nologo=true",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "generate-image",
      "name": "Generate Image (NanoBanana)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 200,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Rate this print-on-demand design prompt on a scale of 1-10 based on visual appeal, print readiness, composition, color harmony, and commercial viability. Respond with only valid JSON in this format: { \\\"score\\\": number, \\\"feedback\\\": string, \\\"approved\\\": boolean } where approved is true if score >= 7. Prompt being evaluated: {{ $('Enhance Prompt').item.json.content[0].text }}\"\n  }]\n}",
        "options": {}
      },
      "id": "quality-check",
      "name": "Quality Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "jsCode": "const qualityResponse = $input.first().json.content[0].text;\nlet quality;\ntry {\n  quality = JSON.parse(qualityResponse);\n} catch(e) {\n  quality = { score: 7, feedback: 'Design generated successfully', approved: true };\n}\n\nconst enhancedPrompt = $('Enhance Prompt').first().json.content[0].text;\nconst imageUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(enhancedPrompt)}?width=1024&height=1024&nologo=true`;\n\nreturn {\n  score: quality.score,\n  feedback: quality.feedback,\n  approved: quality.approved,\n  imageUrl: imageUrl,\n  enhancedPrompt: enhancedPrompt\n};"
      },
      "id": "parse-quality",
      "name": "Parse Quality",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "baseId": "={{ $env.AIRTABLE_BASE_ID }}",
        "tableId": "Designs",
        "fieldsUi": {
          "fieldValues": [
            { "fieldName": "prompt", "fieldValue": "={{ $('Design Trigger').item.json.prompt }}" },
            { "fieldName": "enhanced_prompt", "fieldValue": "={{ $json.enhancedPrompt }}" },
            { "fieldName": "image_url", "fieldValue": "={{ $json.imageUrl }}" },
            { "fieldName": "quality_score", "fieldValue": "={{ $json.score }}" },
            { "fieldName": "status", "fieldValue": "={{ $json.approved ? 'ready' : 'pending' }}" },
            { "fieldName": "created_by", "fieldValue": "={{ $('Design Trigger').item.json.userId }}" }
          ]
        }
      },
      "id": "save-to-airtable",
      "name": "Save to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1230, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-credentials",
          "name": "Airtable Token"
        }
      }
    },
    {
      "parameters": {
        "channel": "={{ $('Design Trigger').item.json.channelId }}",
        "text": "Design generated!",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*Design Generated* :art:\n\n*Quality Score:* {{ $('Parse Quality').item.json.score }}/10\n*Status:* {{ $('Parse Quality').item.json.approved ? 'Ready for Review' : 'Needs Improvement' }}\n*Feedback:* {{ $('Parse Quality').item.json.feedback }}"
              }
            },
            {
              "type": "image",
              "imageUrl": "={{ $('Parse Quality').item.json.imageUrl }}",
              "altText": "Generated Design"
            },
            {
              "type": "actions",
              "elements": [
                {
                  "type": "button",
                  "text": { "type": "plain_text", "text": "Approve" },
                  "style": "primary",
                  "value": "=approve_{{ $('Save to Airtable').item.json.id }}"
                },
                {
                  "type": "button",
                  "text": { "type": "plain_text", "text": "Reject" },
                  "style": "danger",
                  "value": "=reject_{{ $('Save to Airtable').item.json.id }}"
                },
                {
                  "type": "button",
                  "text": { "type": "plain_text", "text": "Regenerate" },
                  "value": "=regenerate_{{ $('Save to Airtable').item.json.id }}"
                }
              ]
            }
          ]
        }
      },
      "id": "notify-slack",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1430, 300],
      "credentials": {
        "slackApi": {
          "id": "slack-credentials",
          "name": "Slack API"
        }
      }
    }
  ],
  "connections": {
    "Design Trigger": {
      "main": [[{ "node": "Enhance Prompt", "type": "main", "index": 0 }]]
    },
    "Enhance Prompt": {
      "main": [[{ "node": "Generate Image (NanoBanana)", "type": "main", "index": 0 }]]
    },
    "Generate Image (NanoBanana)": {
      "main": [[{ "node": "Quality Check", "type": "main", "index": 0 }]]
    },
    "Quality Check": {
      "main": [[{ "node": "Parse Quality", "type": "main", "index": 0 }]]
    },
    "Parse Quality": {
      "main": [[{ "node": "Save to Airtable", "type": "main", "index": 0 }]]
    },
    "Save to Airtable": {
      "main": [[{ "node": "Notify Slack", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateId": "pod-design-generation",
    "description": "Generates AI designs with prompt enhancement and quality scoring"
  }
}
